<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:clipToPadding="false"
    tools:context=".MainActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="top"
        android:padding="16dp">

        <!-- App title -->
        <TextView
            android:id="@+id/titleText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/app_name"
            android:textSize="20sp"
            android:textStyle="bold"
            android:gravity="center"
            android:layout_marginBottom="24dp"
            android:visibility="visible" />

        <!-- Health Connect status line (task 2b): availability / permissions,
             tappable when an action (install/update/grant) is pending. Text is
             set by MainActivity.renderHcStatus. -->
        <TextView
            android:id="@+id/hcStatusText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="16sp"
            android:gravity="center"
            android:layout_marginBottom="32dp"
            android:visibility="visible"
            tools:text="Health Connect connected" />

        <!-- Progress section - visible while an upload/sync is in flight -->
        <ProgressBar
            android:id="@+id/progressBar"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:indeterminate="true"
            android:visibility="invisible" />

        <!-- Upload/login status messages -->
        <TextView
            android:id="@+id/statusText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="14sp"
            android:gravity="center"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="16dp"
            android:visibility="invisible" />

        <!-- Last sync + pending measurements line (task 2b) -->
        <TextView
            android:id="@+id/hcLastSyncText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/hc_never_synced"
            android:textSize="14sp"
            android:gravity="center"
            android:layout_marginBottom="8dp"
            android:visibility="visible" />

        <!-- Manual sync trigger (task 2b); enabled once HC is ready -->
        <Button
            android:id="@+id/syncNowButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:text="@string/sync_now"
            android:enabled="false" />

        <!-- Omron blood-pressure entry point (epic tefal2garmin-939): opens the
             Compose OmronActivity (transfer / readings / settings). -->
        <Button
            android:id="@+id/omronButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:text="@string/omron_open" />

        <!-- Manual backfill (window picker dialog); same enablement as sync -->
        <Button
            android:id="@+id/backfillButton"
            style="?attr/materialButtonOutlinedStyle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/backfill"
            android:enabled="false" />

        <!-- Blood pressure note; while access is missing, tap opens the Health Connect permission screen -->
        <TextView
            android:id="@+id/bloodPressureNote"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/bp_note"
            android:textSize="12sp"
            android:gravity="center"
            android:background="?attr/selectableItemBackground"
            android:padding="8dp" />

        <!-- Hydration note; while access is missing, tap opens the Health Connect permission screen -->
        <TextView
            android:id="@+id/hydrationNote"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/hydration_note"
            android:textSize="12sp"
            android:gravity="center"
            android:background="?attr/selectableItemBackground"
            android:padding="8dp" />

    </LinearLayout>
</ScrollView>
