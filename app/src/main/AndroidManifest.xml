<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Internet permission for the Garmin Connect login/upload clients -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Background-sync problem notifications (health/SyncAlerts.kt) -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Omron M7 BLE readout (epic tefal2garmin-xtg): Android 12+ runtime
         permissions. neverForLocation: the scan targets the Blood Pressure
         service UUID and never derives location. Runtime requests are owned
         by the UI epic; omron/ble only checks before connecting. -->
    <uses-permission
        android:name="android.permission.BLUETOOTH_SCAN"
        android:usesPermissionFlags="neverForLocation"
        tools:targetApi="s" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <!-- Legacy permissions for the pre-31 path (minSdk 26). BLUETOOTH/
         BLUETOOTH_ADMIN are install-time. ACCESS_FINE_LOCATION is a
         dangerous permission whose runtime grant has been required since
         API 23: without it pre-31 BLE scans silently return empty results
         (task tefal2garmin-983). Runtime requests are owned by the UI
         epic; OmronBleClient.missingPermissions checks the grant before
         connecting. Capped at API 30 so Android 12+ installs stay
         location-free. -->
    <uses-permission android:name="android.permission.BLUETOOTH" android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.BLUETOOTH_ADMIN" android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" android:maxSdkVersion="30" />

    <!-- Health Connect (task 2b): the seven synced record types plus
         background reads for the periodic SyncWorker. Must stay in sync with
         health/HealthPermissions.kt (HealthPermissionsTest pins the set).
         On providers where the background read cannot be granted the worker
         degrades gracefully (caught SecurityException, no crash). -->
    <uses-permission android:name="android.permission.health.READ_WEIGHT" />
    <uses-permission android:name="android.permission.health.READ_BODY_FAT" />
    <uses-permission android:name="android.permission.health.READ_BONE_MASS" />
    <uses-permission android:name="android.permission.health.READ_LEAN_BODY_MASS" />
    <uses-permission android:name="android.permission.health.READ_BODY_WATER_MASS" />
    <uses-permission android:name="android.permission.health.READ_BASAL_METABOLIC_RATE" />
    <uses-permission android:name="android.permission.health.READ_HEIGHT" />
    <uses-permission android:name="android.permission.health.READ_HEALTH_DATA_IN_BACKGROUND" />
    <!-- Optional blood pressure sync (health/BloodPressureSync.kt) -->
    <uses-permission android:name="android.permission.health.READ_BLOOD_PRESSURE" />
    <!-- Optional hydration sync (health/HydrationSync.kt) -->
    <uses-permission android:name="android.permission.health.READ_HYDRATION" />

    <!-- Health Connect provider visibility (package visibility on API 30+):
         required for sdkStatus probes and the permission screen intent. -->
    <queries>
        <package android:name="com.google.android.apps.healthdata" />
    </queries>

    <application
        android:name=".ExtraHealthApplication"
        android:allowBackup="true"
        android:fullBackupContent="@xml/backup_rules"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.ExtraHealthGarmin"
        tools:targetApi="26">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.ExtraHealthGarmin.NoActionBar">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Omron blood-pressure UI (epic tefal2garmin-939, task
             tefal2garmin-mnb): Compose host for the transfer flow, readings
             dashboard and settings. Launched only from MainActivity. -->
        <activity
            android:name=".ui.omron.OmronActivity"
            android:exported="false"
            android:theme="@style/Theme.ExtraHealthGarmin.NoActionBar" />

        <!-- Health Connect permission-usage rationale (task 2b): the system
             entry point behind Health Connect's "see how this app uses your
             data". Deliberately an activity-alias onto MainActivity rather
             than a separate activity file: the rationale launch carries the
             health_permissions_rationale extra (see
             MainActivity.EXTRA_HEALTH_PERMISSIONS_RATIONALE) and MainActivity
             answers it with the privacy-policy dialog. Standard launchMode
             means the rationale opens as its own instance on top of the
             caller — no onNewIntent handling needed. The signature-level
             START_VIEW_PERMISSION_USAGE permission restricts who may start
             it. -->
        <activity-alias
            android:name=".HealthPermissionsRationale"
            android:targetActivity=".MainActivity"
            android:exported="true"
            android:permission="android.permission.START_VIEW_PERMISSION_USAGE">
            <intent-filter>
                <action android:name="android.intent.action.VIEW_PERMISSION_USAGE" />
                <category android:name="android.intent.category.HEALTH_PERMISSIONS" />
            </intent-filter>
        </activity-alias>
    </application>
</manifest>
